# Domínio público da aplicação (sem https://)
DOMAIN=unihack.uniceplac.edu.br

# URL completa do frontend (usada no CORS do backend)
FRONTEND_URL=https://unihack.uniceplac.edu.br

# Email para o Let's Encrypt (certificado SSL automático)
ACME_EMAIL=seu@email.com

# Banco de dados principal (PostgreSQL)
POSTGRES_USER=unihack
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE

# Banco de dados do desafio de SQLi (MySQL)
SQLI_DB_PASSWORD=TROQUE_POR_SENHA_FORTE

# Segredo JWT — mínimo 32 caracteres
JWT_SECRET=TROQUE_POR_UMA_CHAVE_LONGA_E_ALEATORIA_AQUI_2025
